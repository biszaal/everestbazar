# EverestBazar — environment variables (Supabase backend)
# Copy to .env.local and fill in from the Supabase dashboard → Settings → API.

# Supabase (safe to expose — used by the browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase service role (server-side only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nepal payments
NEXT_PUBLIC_ESEWA_MERCHANT_CODE=your-merchant-code
ESEWA_SECRET_KEY=your-esewa-secret
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=your-khalti-public-key
KHALTI_SECRET_KEY=your-khalti-secret

# WhatsApp Business API (used by Edge Functions)
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Admin (your Supabase auth user id, allowed into /admin/kyc)
# NEXT_PUBLIC_ so the client can hide the admin UI; real admin ops re-check server-side.
NEXT_PUBLIC_ADMIN_USER_ID=your-supabase-user-id-for-admin
